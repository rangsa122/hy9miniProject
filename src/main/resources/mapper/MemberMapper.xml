<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.diymall.mapper.MemberMapper">

    <insert id="insertMember"
            parameterType="com.diymall.dto.MemberDTO">

        INSERT INTO MEMBER
        (
            MEMBER_ID,
            USER_ID,
            PASSWORD,
            NAME,
            EMAIL
        )
        VALUES
        (
            #{memberId},
            #{userId},
            #{password},
            #{name},
            #{email}
        )

    </insert>


    <select id="selectMemberByUserId"
            parameterType="string"
            resultType="com.diymall.dto.MemberDTO">

        SELECT
            MEMBER_ID,
            USER_ID,
            PASSWORD,
            NAME,
            EMAIL,
            ROLE,
            CREATED_AT
        FROM MEMBER
        WHERE USER_ID = #{userId}

    </select>
    
    <select id="selectMemberList"
        resultType="com.diymall.dto.MemberDTO">

    SELECT
        MEMBER_ID,
        USER_ID,
        PASSWORD,
        NAME,
        EMAIL,
        ROLE,
        CREATED_AT
    FROM MEMBER
    ORDER BY MEMBER_ID DESC

	</select>	

</mapper>